# Frontend Environment Variables (Vite)
# In local development, leave VITE_API_URL empty to use the Vite dev proxy to localhost:8000.
# In production on Vercel, set VITE_API_URL to your deployed Render backend URL (no trailing slash).
VITE_API_URL=

# OneSignal Web Push App ID (from OneSignal Dashboard -> Settings -> Keys & IDs)
VITE_ONESIGNAL_APP_ID=
