# ==============================================================================
# Notification Management System - Environment Configuration Template
# ==============================================================================

# --- Django Core Settings ---
SECRET_KEY=django-insecure-your-secret-key-change-this-in-production-12345
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,*
FRONTEND_URL=http://localhost:3000

# --- Database (Supabase PostgreSQL) ---
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
DATABASE_URL=

# --- External Channel 1: WhatsApp (Option A: Twilio Sandbox | Option B: Meta Cloud API) ---
# Option A (Recommended): Twilio WhatsApp Sandbox
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
WHATSAPP_TEST_RECIPIENT=

# Option B: Meta WhatsApp Cloud API (Alternative)
WHATSAPP_ACCESS_TOKEN=
PHONE_NUMBER_ID=

# --- External Channel 2: Email (Resend) ---
# Single chosen email provider: https://resend.com
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# --- External Channel 3: Web Push (OneSignal) ---
# Setup from onesignal.com -> Settings -> Keys & IDs
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

# --- Frontend Vite Environment Variable (for frontend/.env) ---
# VITE_API_URL=https://your-backend-app.onrender.com (in production) or empty in dev
VITE_API_URL=
